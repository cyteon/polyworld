; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PolyWorld Server"
config/version="dev/1.0.0"
run/main_scene="uid://sryrhvrma77e"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://globals/log.gd"
Network="*res://globals/network.gd"

[debug]

file_logging/enable_file_logging=true

[display]

display_server/driver.windows="headless"
display_server/driver.linuxbsd="headless"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[steam]

initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
